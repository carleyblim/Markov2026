import numpy as np
import matplotlib.pyplot as plt


# parameters
r = 2 * 10**4
T = 10**4
d0 = 10

random_num = np.random.default_rng(1)


# part b: 1 lion simulation
lamb = np.zeros(r, dtype=int)
lion = np.full(r, d0, dtype=int)
alive1 = np.ones(r, dtype=bool)

s1 = np.zeros(T + 1)
s1[0] = 1

for t in range(1, T + 1):

    lamb += random_num.choice([-1, 1], size=r) # either animal moves + or - 1
    lion += random_num.choice([-1, 1], size=r)

    # A lamb is caught if positions are equal
    alive1 &= (lamb != lion)

    s1[t] = np.mean(alive1)

print(s1[t] * 100)


# part c with 2 lions

# reset lamb
lamb = np.zeros(r, dtype=int)

# 2 lions now
lion1 = np.full(r, d0, dtype=int)
lion2 = np.full(r, d0, dtype=int)

alive2 = np.ones(r, dtype=bool)

S2 = np.zeros(T + 1)
S2[0] = 1

for t in range(1, T + 1):

    # Lamb moves once
    lamb += random_num.choice([-1, 1], size=r)

    # Each lion moves independently
    lion1 += random_num.choice([-1, 1], size=r)
    lion2 += random_num.choice([-1, 1], size=r)

    # Caught if either lion is at the lamb's position
    alive2 &= (lamb != lion1) & (lamb != lion2)

    S2[t] = np.mean(alive2)

print(S2[t] * 100)

t = np.arange(T + 1)

fit_mask = (t >= 10**2) & (t <= 10**4)

# log(S) = intercept + slope*log(t)
slope1, intercept1 = np.polyfit(
    np.log(t[fit_mask]),
    np.log(s1[fit_mask]),
    1
)

slope2, intercept2 = np.polyfit(
    np.log(t[fit_mask]),
    np.log(S2[fit_mask]),
    1
)

beta1 = -slope1
beta2 = -slope2


S1_continuum = np.zeros(T + 1)

import math

S1_continuum[1:] = np.array([
    math.erf(d0 / (2 * np.sqrt(x)))
    for x in t[1:]
])


S1_squared = s1**2

plt.figure(figsize=(9, 6))

plt.loglog(t[1:], s1[1:])
plt.loglog(t[1:], S1_continuum[1:])
plt.loglog(t[1:], S2[1:])
plt.loglog(t[1:], S1_squared[1:])

plt.xlabel("Time $t$")
plt.ylabel("Survival probability")

plt.legend()
plt.grid(True, which="both", alpha=0.3)
plt.show()
plt.plot()
