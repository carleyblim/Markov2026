# QUESTION 3D


import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import poisson, gamma, binom

rng = np.random.default_rng(123)
lam = 4
N = 200_000

# --------------------------------------------------
# Method 1: Simulate using exponential gaps
# --------------------------------------------------
counts_gap = np.zeros(N, dtype=int)
first_gap = np.full(N, np.nan)
elapsed = np.zeros(N)
active = np.arange(N)

while len(active) > 0:
    elapsed[active] += rng.exponential(
        scale=1/lam, size=len(active)
    )

    arrived = elapsed[active] <= 1

    counts_gap[active[arrived]] += 1

    first_arrival = arrived & (counts_gap[active] == 1)
    first_gap[active[first_arrival]] = elapsed[active[first_arrival]]

    # Keep original arrays intact to avoid indexing errors
    active = active[arrived]

# --------------------------------------------------
# Method 2: Poisson count plus uniform points
# --------------------------------------------------
counts_unif = rng.poisson(lam, size=N)
first_unif = np.full(N, np.nan)
rasters_unif = []

for i in range(N):
    points = np.sort(rng.uniform(size=counts_unif[i]))

    if counts_unif[i] > 0:
        first_unif[i] = points[0]

    if i < 10:
        rasters_unif.append(points)

# --------------------------------------------------
# Compare N(1) histograms with Poisson(4) pmf
# --------------------------------------------------
k = np.arange(0, 16)

plt.figure(figsize=(8, 4))
plt.hist(counts_gap, bins=np.arange(-0.5, 16.5, 1),
         density=True, alpha=0.5, label="Exponential gaps")
plt.plot(k, poisson.pmf(k, lam), "o-",
         label="Poisson(4) pmf")
plt.xlabel("Number of meteors in one hour")
plt.ylabel("Probability")
plt.legend()
plt.show()

plt.figure(figsize=(8, 4))
plt.hist(counts_unif, bins=np.arange(-0.5, 16.5, 1),
         density=True, alpha=0.5, label="Uniform points")
plt.plot(k, poisson.pmf(k, lam), "o-",
         label="Poisson(4) pmf")
plt.xlabel("Number of meteors in one hour")
plt.ylabel("Probability")
plt.legend()
plt.show()

print("Gap method mean:", counts_gap.mean())
print("Gap method variance:", counts_gap.var())
print("Uniform method mean:", counts_unif.mean())
print("Uniform method variance:", counts_unif.var())

plt.figure(figsize=(9, 4))

for i in range(10):
    times = []
    current = 0

    while True:
        current += rng.exponential(scale=1/lam)
        if current > 1:
            break
        times.append(current)

    plt.scatter(times, [i]*len(times), s=12)

plt.xlabel("Time (hours)")
plt.ylabel("Hour")
plt.title("Ten realizations: exponential gaps")
plt.show()

plt.figure(figsize=(9, 4))

for i, points in enumerate(rasters_unif):
    plt.scatter(points, [i]*len(points), s=12)

plt.xlabel("Time (hours)")
plt.ylabel("Hour")
plt.title("Ten realizations: Poisson count + uniform points")
plt.show()


T3 = rng.exponential(scale=1/lam, size=(N, 3)).sum(axis=1)

t = np.linspace(0, 3, 400)

plt.figure(figsize=(8, 4))
plt.hist(T3, bins=70, density=True, alpha=0.6,
         label="Simulated T3")
plt.plot(t, gamma.pdf(t, a=3, scale=1/lam),
         label="Gamma(3, rate=4) density")
plt.xlabel("Time of third meteor (hours)")
plt.ylabel("Density")
plt.legend()
plt.show()

# Conditional estimates among hours with N(1) = 3

selected = counts_unif == 3

print("P(N(1/2) = 0 | N(1) = 3):",
      np.mean(first_unif[selected] > 0.5))

print("E[T1 | N(1) = 3]:",
      first_unif[selected].mean())

# Correlation between first- and second-half counts

first_half = np.zeros(N, dtype=int)
second_half = np.zeros(N, dtype=int)

for i in range(N):
    points = rng.uniform(size=counts_unif[i])

    first_half[i] = np.sum(points <= 0.5)
    second_half[i] = np.sum(points > 0.5)

print("Correlation between half-hour counts:",
      np.corrcoef(first_half, second_half)[0, 1])

# Total variation distance: Binomial vs Poisson
dts = np.array([1/j for j in range(10, 2001)])
tv = []

for dt in dts:
    m = round(1/dt)
    p = lam*dt

    k = np.arange(0, m+1)
    pb = binom.pmf(k, m, p)
    pp = poisson.pmf(k, lam)

    tv.append(0.5*np.sum(np.abs(pb-pp)))

tv = np.array(tv)

slope, intercept = np.polyfit(np.log(dts), np.log(tv), 1)

plt.figure(figsize=(7, 4))
plt.loglog(dts, tv, ".", label="Total variation distance")
plt.loglog(dts, np.exp(intercept)*dts**slope,
           label=f"Fitted slope = {slope:.3f}")
plt.xlabel("Delta t")
plt.ylabel("Total variation distance")
plt.legend()
plt.show()

print("Fitted log-log slope:", slope)
