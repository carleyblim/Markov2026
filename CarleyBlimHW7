# QUESTION 1C

import numpy as np
import matplotlib.pyplot as plt

x = np.array([
    -1.77, 2.47, 1.34, 2.18, 13.05,
    1.60, 1.50, -1.97, 0.79, 1.50,
    2.00, 2.63, 1.19, -2.31, 0.87
])

def logpost(a, b):
    beta = np.exp(b)
    return len(x)*b - np.sum(np.log(beta**2 + (x-a)**2))

def run_chain(s, T=50000, seed=123):
    rng = np.random.default_rng(seed)
    z = np.array([0.0, 0.0])
    chain = np.zeros((T, 2))
    accepted = 0
    lp = logpost(*z)

    for i in range(T):
        y = z + s*rng.normal(size=2)
        lp_new = logpost(*y)

        if np.log(rng.random()) < min(0, lp_new-lp):
            z = y
            lp = lp_new
            accepted += 1

        chain[i] = z

    return chain, accepted/T

def iact(a, maxlag=5000):
    a = a - np.mean(a)
    n = len(a)
    variance = np.mean(a**2)
    ac = []

    for lag in range(1, min(maxlag, n//2)):
        ac.append(
            np.dot(a[:-lag], a[lag:]) /
            ((n-lag)*variance)
        )

    tau = 1.0
    for i in range(0, len(ac)-1, 2):
        if ac[i] + ac[i+1] <= 0:
            break
        tau += 2*(ac[i] + ac[i+1])

    return tau

chains = {}

for j, s in enumerate([0.02, 0.5, 5]):
    chain, acceptance = run_chain(s, seed=100+j)
    chains[s] = chain

    print("s =", s)
    print("Acceptance rate:", acceptance)
    print("IACT of alpha:", iact(chain[:, 0]))

    plt.figure(figsize=(8, 3))
    plt.plot(chain[:400, 0])
    plt.xlabel("Step")
    plt.ylabel("Alpha")
    plt.title(f"First 400 alpha values, s={s}")
    plt.show()


a_grid = np.linspace(-10, 18, 700)
b_grid = np.linspace(-4, 3, 500)
A, B = np.meshgrid(a_grid, b_grid)

LP = len(x)*B.copy()
for xi in x:
    LP -= np.log(np.exp(2*B) + (xi-A)**2)

W = np.exp(LP - LP.max())
W /= W.sum()

def grid_summary(values):
    mean = np.sum(W*values)
    order = np.argsort(values.ravel())
    v = values.ravel()[order]
    w = W.ravel()[order]
    cdf = np.cumsum(w)
    qs = np.interp([0.05, 0.95], cdf, v)
    return mean, qs

plt.figure(figsize=(7, 5))
plt.contour(A, B, W, levels=12)
plt.scatter(chains[0.5][5000:, 0],
            chains[0.5][5000:, 1],
            s=2, alpha=0.15)
plt.xlabel("Alpha")
plt.ylabel("log beta")
plt.title("Posterior contours and MCMC samples")
plt.show()

chain = chains[0.5][5000:]
for name, values in [
    ("alpha", chain[:, 0]),
    ("beta", np.exp(chain[:, 1]))
]:
    print(name, "MCMC mean:", np.mean(values))
    print(name, "MCMC 90% interval:",
          np.quantile(values, [0.05, 0.95]))

print("Grid alpha:", grid_summary(A))
print("Grid beta:", grid_summary(np.exp(B)))
print("Sample mean of x:", np.mean(x))
print("Sample median of x:", np.median(x))



# QUESTION 1D

import numpy as np
import matplotlib.pyplot as plt

rng = np.random.default_rng(42)
ns = [10, 100, 1000]
results = {}

for n in ns:
    data = 1.5 + 0.8*rng.standard_cauchy((2000, n))

    means = np.mean(data, axis=1)
    medians = np.median(data, axis=1)

    mean_scatter = (
        np.quantile(means, 0.75) -
        np.quantile(means, 0.25)
    ) / 1.349

    median_scatter = (
        np.quantile(medians, 0.75) -
        np.quantile(medians, 0.25)
    ) / 1.349

    results[n] = [mean_scatter, median_scatter]
    print("n =", n)
    print("Mean scatter:", mean_scatter)
    print("Median scatter:", median_scatter)

print(results)


