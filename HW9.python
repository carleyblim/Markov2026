# problem 3b
# this is how I computed the eigenvalues
import numpy as np

Q = np.array([
    [-2, 2, 0, 0],
    [1, -3, 2, 0],
    [0, 2, -4, 2],
    [0, 0, 3, -3]
])

eigenvalues = np.linalg.eigvals(Q)

print(eigenvalues)

# problem 3c
import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import expm

Q = np.array([
    [-2, 2, 0, 0],
    [1, -3, 2, 0],
    [0, 2, -4, 2],
    [0, 0, 3, -3]
])

x0 = np.array([1, 0, 0, 0])

pi = np.array([3/19, 6/19, 6/19, 4/19])

times = np.linspace(0, 5, 500)

probabilities = []

for t in times:
    xt = expm(Q.T * t) @ x0
    probabilities.append(xt)

probabilities = np.array(probabilities)

TV = 0.5 * np.sum(np.abs(probabilities - pi), axis=1)

plt.figure(figsize=(10, 6))

for i in range(4):
    plt.semilogy(times, probabilities[:, i], label=f'State {i}')

plt.xlabel('Time (hours)')
plt.ylabel('Probability')
plt.title('State Probabilities Over Time')
plt.legend()
plt.grid()
plt.show()

lambda2 = -1.51071143

plt.figure(figsize=(10, 6))

plt.semilogy(times, TV, label='TV(t)')
plt.semilogy(times, np.exp(lambda2 * times),
             '--', label='Reference slope lambda2')

plt.xlabel('Time (hours)')
plt.ylabel('Total Variation Distance')
plt.title('Convergence to Stationary Distribution')
plt.legend()
plt.grid()
plt.show()

time_001 = np.interp(0.01, TV[::-1], times[::-1])

print(time_001)
