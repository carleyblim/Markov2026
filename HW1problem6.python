import numpy as np
import matplotlib.pyplot as plt

# Analytic probability
p_true = 23 * np.pi / 192

# Sample sizes
N_values = np.logspace(2, 6, 30).astype(int)

estimates = []

for N in N_values:
    X = np.random.uniform(0, 1, N)
    Y = np.random.uniform(0, 1, N)
    Z = np.random.uniform(0, 1, N)

    success = (X**2 + Y**2 < Z) & (Z**2 > X*Y)

    estimates.append(np.mean(success))

# Plot
plt.figure(figsize=(8, 5))
plt.plot(N_values, estimates, marker='o', label='Monte Carlo Estimate')
plt.axhline(p_true, linestyle='--', label='Value')

plt.xscale('log')
plt.xlabel('Sample Size N')
plt.ylabel('Estimated Probability')
plt.title('Monte Carlo Estimate vs. Sample Size')
plt.legend()
plt.show()

print("Probability:", p_true)
